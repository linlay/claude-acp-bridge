# Local HTTP port for claude-acp-bridge.
CLAUDE_ACP_BRIDGE_PORT=17070

# Listen address; uncomment and set to 0.0.0.0 only when remote access is required.
# CLAUDE_ACP_BRIDGE_ADDR=

# Optional bearer token; leave commented to disable auth.
# CLAUDE_ACP_BRIDGE_AUTH_TOKEN=

# Claude Code CLI command or absolute path.
# CLAUDE_CODE_CLI=claude

# Extra arguments passed to Claude Code CLI.
# CLAUDE_CODE_ARGS="--permission-mode dontAsk"

# Optional network proxy inherited by Claude Code CLI backend.
# http_proxy=http://127.0.0.1:8001
# HTTP_PROXY=http://127.0.0.1:8001
# https_proxy=http://127.0.0.1:8001
# HTTPS_PROXY=http://127.0.0.1:8001

# Idle ACP session timeout in milliseconds.
# CLAUDE_ACP_BRIDGE_IDLE_TIMEOUT_MS=1800000
